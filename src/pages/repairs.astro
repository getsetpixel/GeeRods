---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Rod Repairs — GeeRods" description="Expert rod repairs with fast turnaround. Tip replacement, guide replacement, blank repair, handle refurbishment and full refinishing.">

  <section class="page-hero">
    <div class="page-hero-copy">
      <span class="eyebrow">Repairs</span>
      <h1>Back fishing fast.</h1>
      <p>Snapped tips, worn guides, cracked blanks and tired finishes — we fix them all. Fast turnaround, premium materials, and a result that looks and performs like new.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="section-head">
      <span class="eyebrow">Repair services</span>
      <h2>What we fix</h2>
    </div>
    <div class="repair-list">
      <div class="repair-item">
        <div class="repair-icon">✦</div>
        <div>
          <h4>Tip replacement</h4>
          <p>Snapped or damaged tip sections replaced with matched blanks and re-wrapped guides. Most jobs completed same day.</p>
        </div>
      </div>
      <div class="repair-item">
        <div class="repair-icon">✦</div>
        <div>
          <h4>Guide replacement</h4>
          <p>Worn, cracked or missing guides replaced with quality SIC or titanium frames, re-wrapped and epoxy-sealed.</p>
        </div>
      </div>
      <div class="repair-item">
        <div class="repair-icon">✦</div>
        <div>
          <h4>Blank repair</h4>
          <p>Stress cracks and minor fractures stabilised and reinforced — we'll assess and advise honestly on whether repair is worthwhile.</p>
        </div>
      </div>
      <div class="repair-item">
        <div class="repair-icon">✦</div>
        <div>
          <h4>Handle refurbishment</h4>
          <p>Cork and EVA handles cleaned, filled and reshaped. Reel seats tightened or replaced. Looks and feels brand new.</p>
        </div>
      </div>
      <div class="repair-item">
        <div class="repair-icon">✦</div>
        <div>
          <h4>Full refinish</h4>
          <p>Complete strip-back, re-wrap and epoxy coat — ideal for cherished rods that deserve a second life.</p>
        </div>
      </div>
      <div class="repair-item">
        <div class="repair-icon">✦</div>
        <div>
          <h4>Reel seat replacement</h4>
          <p>Loose, cracked or corroded reel seats removed and replaced with quality fittings, properly bedded and sealed.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section alt-bg">
    <div class="turnaround-panel">
      <div class="turnaround-copy">
        <span class="eyebrow">Turnaround</span>
        <h2>Fast, honest, no fuss</h2>
        <p>Most standard repairs are turned around within 48 hours of receiving your rod. We'll always give you an honest assessment — if a repair isn't worth doing, we'll tell you.</p>
        <ul class="turnaround-list">
          <li>Free assessment on all repairs</li>
          <li>No fix, no fee guarantee</li>
          <li>Tracked return shipping available</li>
          <li>Updates at every stage</li>
        </ul>
        <a href="/contact" class="btn btn-primary">Send us your rod →</a>
      </div>
      <div class="turnaround-img">
        <img src="https://i.ytimg.com/vi/NaV4LrzDzh4/maxresdefault.jpg" alt="Rod repair in progress" loading="lazy" />
      </div>
    </div>
  </section>

</Layout>
