---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title       = 'GeeRods — Custom Rod Building & Repair',
  description = 'Bespoke fishing rods hand-built to your exact spec. Expert repairs with fast turnaround. UK-based custom rod specialist.',
} = Astro.props;

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/',        label: 'Home' },
  { href: '/builds',  label: 'Builds' },
  { href: '/repairs', label: 'Repairs' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/blog',    label: 'Blog' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ═══════════════════════════════════════════
     HEADER
════════════════════════════════════════════ -->
<header class="topbar" role="banner">
  <div class="topbar-inner">
    <a href="/" class="brand" aria-label="GeeRods home">
      <div class="brand-mark" aria-hidden="true">G</div>
      <div class="brand-text">
        <span class="brand-name">GeeRods</span>
        <span class="brand-sub">Build + Repair</span>
      </div>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      {navLinks.map(link => (
        <a href={link.href} class={`nav-link${isActive(link.href) ? ' active' : ''}`}>
          {link.label}
        </a>
      ))}
      <a href="/contact" class={`nav-link btn-nav${isActive('/contact') ? ' active' : ''}`}>
        Get a Quote
      </a>
    </nav>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- ═══════════════════════════════════════════
     MAIN CONTENT
════════════════════════════════════════════ -->
<main>
  <slot />
</main>

<!-- ═══════════════════════════════════════════
     FOOTER
════════════════════════════════════════════ -->
<footer class="footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="brand-mark small" aria-hidden="true">G</div>
      <div>
        <span class="brand-name">GeeRods</span>
        <span class="footer-tagline">Custom Rod Building &amp; Repair</span>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/">Home</a>
      <a href="/builds">Builds</a>
      <a href="/repairs">Repairs</a>
      <a href="/gallery">Gallery</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </nav>

    <div class="footer-contact">
      <a href="mailto:hello@geerods.com">hello@geerods.com</a>
    </div>
  </div>
  <div class="footer-base">
    <span>&copy; {new Date().getFullYear()} GeeRods. All rights reserved.</span>
    <span>Hand-built in the UK.</span>
  </div>
</footer>

<script>
  // ── Mobile nav ──────────────────────────────────
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const nav    = document.querySelector('.site-nav') as HTMLElement;

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      const spans = toggle.querySelectorAll('span');
      if (isOpen) {
        (spans[0] as HTMLElement).style.transform = 'translateY(7px) rotate(45deg)';
        (spans[1] as HTMLElement).style.opacity   = '0';
        (spans[2] as HTMLElement).style.transform = 'translateY(-7px) rotate(-45deg)';
      } else {
        spans.forEach(s => { (s as HTMLElement).style.transform = ''; (s as HTMLElement).style.opacity = ''; });
      }
    });

    document.addEventListener('click', e => {
      if (!toggle.contains(e.target as Node) && !nav.contains(e.target as Node)) {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.querySelectorAll('span').forEach(s => {
          (s as HTMLElement).style.transform = '';
          (s as HTMLElement).style.opacity   = '';
        });
      }
    });
  }

  // ── Header scroll shadow ────────────────────────
  const header = document.querySelector('.topbar') as HTMLElement;
  window.addEventListener('scroll', () => {
    if (header) header.style.boxShadow = window.scrollY > 10
      ? '0 4px 24px rgba(0,0,0,0.32)'
      : 'none';
  }, { passive: true });
</script>

</body>
</html>
